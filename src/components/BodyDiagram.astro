---
/** Anatomical body map with data-driven placement highlights. */
interface Props {
  /** Placement slugs from axes.json to highlight. */
  selected?: string[];
  class?: string;
}

const { selected = [], class: className = '' } = Astro.props;
const on = (zone: string) => (selected.includes(zone) ? 'zone on' : 'zone');
---

<div class={`diagram ${className}`}>
  <div class="body-map">
    <picture>
      <source
        type="image/webp"
        srcset="/images/tools/body-map-base-400.webp 400w, /images/tools/body-map-base-800.webp 800w, /images/tools/body-map-base-1200.webp 1200w"
        sizes="(min-width: 1100px) 200px, (min-width: 620px) 220px, 240px"
      />
      <img
        src="/images/tools/body-map-base.png"
        alt="Anatomical body map shown from the front and back"
        width="1456"
        height="1092"
        loading="lazy"
        decoding="async"
      />
    </picture>

    <svg class="zone-overlay" viewBox="0 0 1456 1092" aria-hidden="true">
      <!-- Forearms -->
      <path class={on('forearm')} d="M321 382C307 427 292 479 274 523" />
      <path class={on('forearm')} d="M582 382C598 428 612 478 630 522" />
      <path class={on('forearm')} d="M858 382C844 429 829 479 811 524" />
      <path class={on('forearm')} d="M1117 382C1132 429 1147 479 1165 523" />

      <!-- Upper arms and shoulder caps -->
      <path class={on('shoulder')} d="M343 247C332 285 328 326 323 363" />
      <path class={on('shoulder')} d="M559 247C570 285 575 326 580 363" />
      <path class={on('shoulder')} d="M880 247C869 286 864 326 859 363" />
      <path class={on('shoulder')} d="M1095 247C1106 286 1111 326 1116 363" />

      <!-- Chest, spine and ribs -->
      <path class={`area ${selected.includes('chest') ? 'on' : ''}`} d="M365 236C414 218 489 218 538 236L520 322C474 343 426 343 382 322Z" />
      <path class={on('spine')} d="M998 160L998 477" />
      <path class={on('ribs')} d="M370 331C351 377 350 425 365 467" />
      <path class={on('ribs')} d="M531 331C550 377 551 425 536 467" />

      <!-- Thighs -->
      <path class={on('thigh')} d="M405 565C394 625 397 691 409 747" />
      <path class={on('thigh')} d="M497 565C508 625 505 691 493 747" />
      <path class={on('thigh')} d="M950 565C941 625 944 691 956 747" />
      <path class={on('thigh')} d="M1045 565C1054 625 1051 691 1039 747" />
    </svg>
  </div>

  <div class="view-labels small" aria-hidden="true">
    <span>Front</span>
    <span>Back</span>
  </div>

  <p class="legend small">
    <span class="dot" aria-hidden="true"></span>
    Selected placement
  </p>
</div>

<style>
  .diagram { display: grid; gap: 4px; justify-items: center; }

  .body-map {
    position: relative;
    width: 100%;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: var(--radius-sm);
    background: #1d1d1d;
  }

  picture, img { display: block; width: 100%; height: 100%; }
  img { object-fit: cover; }

  .zone-overlay {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    pointer-events: none;
  }

  .zone {
    fill: none;
    stroke: transparent;
    stroke-width: 42;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .zone.on { stroke: var(--accent); opacity: 0.78; }

  .area { fill: transparent; }
  .area.on { fill: var(--accent); opacity: 0.52; }

  .view-labels {
    display: grid;
    grid-template-columns: 1fr 1fr;
    width: 82%;
    color: var(--text-muted);
    text-align: center;
  }

  .legend {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--text-muted);
  }

  .dot {
    width: 9px;
    height: 9px;
    border-radius: 50%;
    background: var(--accent);
  }
</style>
