---
import Icon from './Icon.astro';

/**
 * «Скопировать описание для мастера» - DESIGN.md §7, PROJECT.md §9.
 * Это причина выбрать сайт, а не Pinterest, и главный повод вернуться,
 * поэтому блок стоит отдельной секцией, а не строкой в подзаголовке.
 * Работает целиком на клиенте, ноль запросов к серверу.
 */
interface Props {
  value?: string;
}

const {
  value = 'fine line butterfly, ~5 cm, inner forearm, black only, no shading',
} = Astro.props;
---

<section class="section container" aria-labelledby="brief-head">
  <div class="panel brief">
    <Icon name="clipboard" size={34} class="ic" />

    <div class="body">
      <h2 id="brief-head">Copy a brief for your artist</h2>
      <label class="visually-hidden" for="brief-input">Tattoo brief</label>
      <input
        id="brief-input"
        class="field"
        type="text"
        value={value}
        readonly
        data-brief-input
      />
      <p class="small muted">Clear details, ready to share.</p>
    </div>

    <button class="btn btn-primary" type="button" data-brief-copy>
      <span data-brief-label>Copy description</span>
    </button>
  </div>
</section>

<style>
  .brief {
    display: grid;
    grid-template-columns: auto 1fr;
    align-items: start;
    gap: 12px 16px;
    padding: 18px;
  }

  .ic { color: var(--accent); }

  .body { display: grid; gap: 8px; }

  .field {
    width: 100%;
    min-height: var(--tap);
    padding: 0 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 13px;
  }

  .brief .btn { grid-column: 2; justify-self: start; }

  @media (min-width: 860px) {
    .brief {
      grid-template-columns: auto 1fr auto;
      align-items: center;
      padding: 20px 22px;
    }
    .brief .btn { grid-column: auto; }
  }
</style>
