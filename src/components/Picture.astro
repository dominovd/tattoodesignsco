---
import { srcSet, imageUrl, GALLERY_SIZES } from '@lib/images';

interface Props {
  /** Путь без суффикса размера, напр. "ideas/flower-tattoo-ideas/01" */
  src: string;
  alt: string;
  /** CSS aspect-ratio. По умолчанию 3/4 - DESIGN.md §4 */
  ratio?: string;
  sizes?: string;
  /** Первое изображение страницы - eager + high, всё остальное ленивое (§4) */
  priority?: boolean;
  /** Включить AVIF-источник. Требует, чтобы .avif реально лежали рядом. */
  avif?: boolean;
  class?: string;
}

const {
  src,
  alt,
  ratio = '3 / 4',
  sizes = GALLERY_SIZES,
  priority = false,
  avif = false,
  class: className = '',
} = Astro.props;
---

<picture class={`pic ${className}`} style={`--ratio: ${ratio}`}>
  {avif && <source type="image/avif" srcset={srcSet(src, 'avif')} sizes={sizes} />}
  <source type="image/webp" srcset={srcSet(src, 'webp')} sizes={sizes} />
  <img
    src={imageUrl(src, 800)}
    srcset={srcSet(src)}
    sizes={sizes}
    alt={alt}
    width="800"
    height="1067"
    loading={priority ? 'eager' : 'lazy'}
    decoding={priority ? 'sync' : 'async'}
    fetchpriority={priority ? 'high' : 'auto'}
  />
</picture>

<style>
  /* Место резервируется заранее - нулевой CLS, DESIGN.md §4 */
  .pic {
    display: block;
    position: relative;
    aspect-ratio: var(--ratio);
    overflow: hidden;
    background: var(--card-hover);
    border-radius: var(--radius) var(--radius) 0 0;
  }

  .pic img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    color: var(--text-muted);
    font-size: 12px;
  }
</style>
