---
import Picture from './Picture.astro';
import Icon from './Icon.astro';
import axes from '@data/axes.json';

/**
 * Ось аудитории - PROJECT.md §3.
 * Мужчины 546,8K, женщины 299,0K, пары 167,0K. Мужская ось крупнейшая и
 * наименее обслуженная, поэтому стоит первой и получает равный вес в
 * изображениях по всей главной.
 */
const { audience } = axes;
---

<section class="section container" aria-labelledby="audience-head">
  <div class="section-head">
    <h2 id="audience-head">Browse by audience</h2>
  </div>

  <div class="grid grid-4">
    {
      audience.map((a, i) => (
        <a class="acard" href={`/for/${a.slug}/`}>
          <Picture
            src={a.image}
            alt={`${a.label} tattoo ideas`}
            ratio="4 / 3"
            sizes="(min-width: 960px) 288px, 47vw"
            priority={i === 0}
          />
          <div class="body">
            <span class="label">
              {a.label}
              <Icon name="chevron" size={16} class="chev" />
            </span>
            <span class="small muted">{a.blurb}</span>
          </div>
        </a>
      ))
    }

    <div class="quiz panel panel-accent">
      <Icon name="timer" size={30} class="quiz-icon" />
      <h3>30-second tattoo quiz</h3>
      <p class="small muted">
        Answer a few quick questions to get ideas you'll love.
      </p>
      <a class="btn btn-primary" href="/tools/quiz/">Start quiz</a>
    </div>
  </div>
</section>

<style>
  .acard {
    display: block;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .acard:hover { border-color: var(--line-strong); color: inherit; }

  .body {
    display: grid;
    gap: 2px;
    padding: 10px 12px 12px;
    border-top: 1px solid var(--line);
  }

  .label {
    display: flex;
    align-items: center;
    justify-content: space-between;
    font-weight: 700;
    font-size: 16px;
  }

  .chev { color: var(--accent); }

  .quiz {
    display: grid;
    justify-items: center;
    align-content: center;
    gap: 10px;
    padding: 24px 18px;
    text-align: center;
  }

  .quiz-icon { color: var(--accent); }
  .quiz p { max-width: 30ch; }
  .quiz .btn { margin-top: 4px; }
</style>
