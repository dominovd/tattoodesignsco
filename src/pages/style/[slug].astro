---
import AxisLeaf from '@components/AxisLeaf.astro';
import axes from '@data/axes.json';
import { styleGalleries } from '@data/style-galleries';

export function getStaticPaths() {
  return axes.styles.map((s) => ({ params: { slug: s.slug }, props: { s } }));
}

const { s } = Astro.props;
const path = `/style/${s.slug}/`;
const label = s.label.toLowerCase();
const galleryItems = styleGalleries[s.slug];

const siblings = axes.styles
  .filter((x) => x.slug !== s.slug)
  .map((x) => ({ label: x.label, href: `/style/${x.slug}/` }));
---

<AxisLeaf
  h1={`${s.label} tattoo ideas`}
  title={`${s.label} tattoo ideas - how the style holds up | TattooDesignsCo`}
  description={`${s.label} tattoo ideas with size, area and colour on every image.`}
  path={path}
  contentKey={`style/${s.slug}`}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: 'Styles', href: '/style/' },
    { label: s.label, href: path },
  ]}
  answer={[
    `${s.label} work across body areas, with the size and colour listed on every image.`,
    'Line weight decides how small a design can go and still read years later.',
  ]}
  gallerySlug={`style-${s.slug}`}
  galleryDefaults={{
    placement: 'Forearm',
    size: '5-12 cm',
    style: s.label,
    color: 'Black',
    altPattern: `${s.label} tattoo idea, reference {n}`,
    items: galleryItems,
  }}
  siblings={siblings}
  brief={`${label} design, ~8 cm, inner forearm, black only`}
/>
