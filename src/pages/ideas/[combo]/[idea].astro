---
import BaseLayout from '@layouts/BaseLayout.astro';
import Picture from '@components/Picture.astro';
import Icon from '@components/Icon.astro';
import BodyDiagram from '@components/BodyDiagram.astro';
import AdSlot from '@components/AdSlot.astro';
import Faq from '@components/Faq.astro';
import combos from '@data/combos.json';
import { ideaRecords, imagePath } from '@lib/gallery';
import { imageUrl } from '@lib/images';
import site from '@data/site.json';

/**
 * Страница отдельной идеи.
 *
 * Почему это страница, а не только лайтбокс (DESIGN.md §5): у неё есть
 * собственный URL, поэтому она шарится, открывается без JS и годится как
 * пин-таргет для Pinterest. Лайтбокс навешивается сверху как прогрессивное
 * улучшение - карточка в галерее остаётся обычной ссылкой.
 *
 * ВАЖНО про индексацию. 769 страниц комбинаций × 16-24 идеи это 12-18 тысяч
 * почти одинаковых страниц. Ровно тот профиль, который PROJECT.md §8 называет
 * scaled content abuse. Поэтому по умолчанию здесь `noindex, follow`: ссылки
 * работают, вес течёт, в индекс страница не лезет. Открывать по одной,
 * выставляя `"index": true` у записи в combos.json - тем, у которых есть
 * собственный уникальный текст и которые реально собирают показы.
 */
export function getStaticPaths() {
  const paths: any[] = [];

  for (const combo of combos.items) {
    const records = ideaRecords(combo.slug, combo.images, combo.gallery as any);

    records.forEach((record, i) => {
      paths.push({
        params: { combo: combo.slug, idea: record.slug },
        props: { combo, record, index: i, records },
      });
    });
  }

  return paths;
}

const { combo, record, index, records } = Astro.props;

const path = `/ideas/${combo.slug}/${record.slug}/`;
const image = imagePath(combo.slug, index);

const prev = records[index - 1];
const next = records[index + 1];

const similar = records
  .filter((_r: any, i: number) => i !== index)
  .slice(0, 8)
  .map((r: any, i: number) => ({
    ...r,
    image: imagePath(combo.slug, records.indexOf(r)),
    href: `/ideas/${combo.slug}/${r.slug}/`,
    key: i,
  }));

const specs = [
  ['Placement', record.placement],
  ['Size', `~${record.size}`],
  ['Style', record.style],
  ['Color', record.color],
  ['Shading', record.shading ?? '-'],
  ['Session', record.session ?? '-'],
].filter(([, v]) => v && v !== '-');

const brief = [
  `${record.style.toLowerCase()} ${record.name.toLowerCase()}`,
  `~${record.size}, ${record.placement.toLowerCase()}, ${record.color.toLowerCase()}`,
  record.shading ? `${record.shading.toLowerCase()} shading` : null,
]
  .filter(Boolean)
  .join(', ');

const variants = [
  { icon: 'ruler', label: 'Smaller · 8 cm' },
  { icon: 'person', label: `Outer ${combo.placementLabel.toLowerCase()}` },
  { icon: 'wave', label: 'More shading' },
  { icon: 'sun', label: 'Simplify the detail' },
];

const why = [
  `The composition follows the length of the ${combo.placementLabel.toLowerCase()}.`,
  'Open space between elements keeps fine lines readable.',
  'The design stops short of the joint, where skin moves most.',
];

const ask = [
  `Is ${record.size} enough for this level of detail?`,
  'Where should the design stop above the joint?',
  'How much shading suits my skin and placement?',
];

const faqItems = [
  {
    q: 'Can this design be made smaller?',
    a: `It can, but detail is the limit rather than the outline. Below roughly ${record.size} the finest lines start to sit close enough together that they can merge as the tattoo settles. Ask your artist where the floor is for this particular drawing.`,
  },
  {
    q: `Will fine lines work on the ${combo.placementLabel.toLowerCase()}?`,
    a: `The ${combo.placementLabel.toLowerCase()} is one of the flatter, more forgiving areas, which is why fine line work is common here. How it holds up long term depends on the artist, the line weight and your skin - that is a conversation for the consultation.`,
  },
  {
    q: 'Can the shading be removed?',
    a: 'Yes - an outline-only version is a normal request and usually shortens the session. Bring both versions to your artist and ask which reads better at your chosen size.',
  },
];

const pinUrl = `https://www.pinterest.com/pin/create/button/?url=${encodeURIComponent(new URL(path, site.url).href)}&media=${encodeURIComponent(new URL(imageUrl(image, 1200), site.url).href)}&description=${encodeURIComponent(record.name)}`;
---

<BaseLayout
  title={`${record.name} | TattooDesignsCo`}
  description={record.summary ?? `${record.name} - ${record.size}, ${record.placement.toLowerCase()}, ${record.style.toLowerCase()}.`}
  path={path}
  noindex={record.index !== true}
  preloadImage={imageUrl(image, 800)}
  crumbs={[
    { label: 'Home', href: '/' },
    { label: combo.h1, href: `/ideas/${combo.slug}/` },
    { label: record.name, href: path },
  ]}
>
  <section class="container detail">
    <div class="media">
      <div class="hero-shot panel">
        <Picture
          src={image}
          alt={record.summary ?? record.name}
          ratio="4 / 5"
          sizes="(min-width: 960px) 560px, 94vw"
          priority={true}
        />
        <button class="zoom" type="button" data-zoom aria-label="View larger">
          <Icon name="search" size={18} />
        </button>
      </div>

      <nav class="pager" aria-label="Ideas in this collection">
        {
          prev ? (
            <a class="btn btn-outline" href={`/ideas/${combo.slug}/${prev.slug}/`}>
              ← Previous idea
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a class="btn btn-outline" href={`/ideas/${combo.slug}/${next.slug}/`}>
              Next idea →
            </a>
          )
        }
      </nav>
    </div>

    <div class="info">
      <p class="eyebrow small">
        {combo.placementLabel} idea #{String(index + 1).padStart(2, '0')}
      </p>
      <h1>{record.name}</h1>
      {record.summary && <p class="lead">{record.summary}</p>}

      <div class="actions">
        <button
          class="btn btn-primary"
          type="button"
          data-save={path}
          data-save-title={record.name}
          data-save-image={image}
          aria-pressed="false"
        >
          <Icon name="bookmark" size={18} />
          <span>Save idea</span>
        </button>

        <a class="btn btn-outline" href={pinUrl} target="_blank" rel="noopener nofollow">
          <Icon name="pinterest" size={18} />
          <span>Pin</span>
        </a>

        <button class="btn btn-outline" type="button" data-share={record.name}>
          <Icon name="arrow" size={18} />
          <span>Share</span>
        </button>
      </div>

      <table class="specs">
        <tbody>
          {specs.map(([k, v]) => (
            <tr>
              <th scope="row">{k}</th>
              <td>{v}</td>
            </tr>
          ))}
        </tbody>
      </table>
      <p class="small muted">Timing and price vary by artist and location.</p>

      <div class="panel brief">
        <h2>Copy a brief for your artist</h2>
        <label class="visually-hidden" for="idea-brief">Description for your artist</label>
        <textarea id="idea-brief" class="field" rows="3" readonly data-brief-input>{brief}</textarea>
        <button class="btn btn-primary wide" type="button" data-brief-copy>
          <span data-brief-label>Copy description</span>
        </button>
        <p class="small muted hint">
          Use this as a reference. Ask your artist to adapt the composition to
          your anatomy rather than copying it exactly.
        </p>
      </div>
    </div>
  </section>

  <section class="section container" aria-labelledby="variants-head">
    <div class="panel variants">
      <div>
        <h2 id="variants-head">Make this idea your own</h2>
        <ul class="chips-grid">
          {
            variants.map((v) => (
              <li class="variant">
                <Icon name={v.icon} size={20} class="ic" />
                <span>{v.label}</span>
              </li>
            ))
          }
        </ul>
      </div>

      <div class="place">
        <BodyDiagram selected={['forearm']} />
        <a class="btn btn-outline" href="/tools/size-guide/">Open size guide</a>
      </div>
    </div>
  </section>

  <section class="section container two-col">
    <div class="panel box">
      <h2>Why this design works on the {combo.placementLabel.toLowerCase()}</h2>
      <ul class="why">
        {why.map((w) => <li>{w}</li>)}
      </ul>
    </div>

    <div class="panel box">
      <h2>Ask your artist</h2>
      <ul class="ask">
        {
          ask.map((q) => (
            <li>
              <Icon name="check" size={16} class="tick" />
              <span>{q}</span>
            </li>
          ))
        }
      </ul>
    </div>
  </section>

  <div class="container"><AdSlot id={`${combo.slug}-idea`} height={100} /></div>

  <section class="section container" aria-labelledby="similar-head">
    <div class="section-head">
      <h2 id="similar-head">Similar {combo.placementLabel.toLowerCase()} tattoo ideas</h2>
    </div>

    <div class="grid grid-gallery">
      {
        similar.map((s: any) => (
          <article class="scard">
            <a href={s.href}>
              <Picture src={s.image} alt={s.name} />
            </a>
            <button
              class="iconbtn"
              type="button"
              data-save={s.href}
              data-save-title={s.name}
              data-save-image={s.image}
              aria-pressed="false"
              aria-label={`Save ${s.name}`}
            >
              <Icon name="bookmark" size={18} />
            </button>
            <p class="cap small">
              <a href={s.href}>{s.name}</a>
              <span class="muted"> · {s.size}</span>
            </p>
          </article>
        ))
      }
    </div>
  </section>

  <nav class="section container pager wide-pager" aria-label="Collection navigation">
    <a class="btn btn-outline" href={`/ideas/${combo.slug}/`}>
      ← Back to all {combo.placementLabel.toLowerCase()} ideas
    </a>
    {
      next && (
        <a class="btn btn-outline" href={`/ideas/${combo.slug}/${next.slug}/`}>
          Next idea: {next.name.toLowerCase()} →
        </a>
      )
    }
  </nav>

  <Faq items={faqItems} title="About this tattoo idea" />
</BaseLayout>

<style>
  .detail {
    display: grid;
    gap: 20px;
    padding-top: 20px;
  }

  .hero-shot { position: relative; padding: 10px; }

  .zoom {
    position: absolute;
    top: 20px;
    right: 20px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border: 1px solid var(--line-strong);
    border-radius: 50%;
    background: rgba(17, 17, 17, 0.8);
    color: var(--text);
  }

  .pager {
    display: flex;
    justify-content: space-between;
    gap: 10px;
    margin-top: 12px;
  }

  .wide-pager .btn { flex: 1; }

  .eyebrow {
    text-transform: uppercase;
    letter-spacing: 0.1em;
    color: var(--text-muted);
    margin-bottom: 6px;
  }

  .info h1 { font-size: clamp(24px, 4vw, 34px); }
  .info .lead { margin-top: 10px; }

  .actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 18px 0;
  }

  .specs {
    width: 100%;
    border-collapse: collapse;
    border: 1px solid var(--line);
    border-radius: var(--radius-sm);
    overflow: hidden;
    font-size: 14px;
  }

  .specs th, .specs td { padding: 9px 14px; text-align: left; }
  .specs th { width: 42%; color: var(--text-muted); font-weight: 500; }
  .specs tr + tr th, .specs tr + tr td { border-top: 1px solid var(--line); }
  .specs th + td { border-left: 1px solid var(--line); }

  .brief { margin-top: 14px; padding: 16px; display: grid; gap: 10px; }
  .brief h2 { font-size: 17px; }

  .field {
    width: 100%;
    padding: 10px 12px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: var(--bg);
    color: var(--text);
    font-family: var(--font-mono);
    font-size: 13px;
    resize: vertical;
  }

  .wide { width: 100%; }
  .hint { max-width: 62ch; }

  .variants { display: grid; gap: 20px; padding: 20px; }
  .variants h2 { font-size: 19px; margin-bottom: 12px; }

  .chips-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .variant {
    display: flex;
    align-items: center;
    gap: 10px;
    min-height: var(--tap);
    padding: 0 14px;
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    font-size: 14px;
  }

  .ic, .tick { color: var(--accent); }

  .place { display: grid; gap: 12px; justify-items: center; }

  .two-col { display: grid; gap: 12px; }
  .box { padding: 20px; }
  .box h2 { font-size: 19px; margin-bottom: 12px; }

  .why, .ask { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  .why li, .ask li { color: var(--text-muted); font-size: 15px; }
  .ask li { display: flex; align-items: flex-start; gap: 10px; }

  .scard {
    position: relative;
    background: var(--card);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    overflow: hidden;
  }

  .iconbtn {
    position: absolute;
    top: 8px;
    right: 8px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: var(--tap);
    height: var(--tap);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius-sm);
    background: rgba(17, 17, 17, 0.78);
    color: var(--text);
  }

  .iconbtn[aria-pressed='true'] { border-color: var(--accent); color: var(--accent); }

  .cap { padding: 9px 12px 11px; border-top: 1px solid var(--line); }
  .cap a { font-weight: 600; }

  @media (min-width: 900px) {
    .detail { grid-template-columns: minmax(0, 1.05fr) minmax(0, 1fr); gap: 28px; }
    .variants { grid-template-columns: 1fr 300px; align-items: center; }
    .two-col { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .chips-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
</style>
